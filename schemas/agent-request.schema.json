{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/abluvsu/indian_career_strategy/schemas/agent-request.schema.json",
  "title": "Career Strategy Agent Request",
  "type": "object",
  "required": ["schemaVersion", "requestId", "task", "input"],
  "properties": {
    "schemaVersion": { "const": "career-strategy.agent.v1" },
    "requestId": { "type": "string", "minLength": 1 },
    "task": { "enum": ["score_job", "match_email"] },
    "actor": { "enum": ["user", "agent", "system"] },
    "createdAt": { "type": "string" },
    "input": { "type": "object" }
  },
  "additionalProperties": false
}
