{
  "name": "indian-career-strategy",
  "version": "0.2.0",
  "private": false,
  "description": "India-first, local-first job search and email tracking agent foundation.",
  "type": "module",
  "homepage": "https://github.com/abluvsu/indian_career_strategy#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abluvsu/indian_career_strategy.git"
  },
  "bugs": {
    "url": "https://github.com/abluvsu/indian_career_strategy/issues"
  },
  "keywords": [
    "career",
    "job-search",
    "email-tracker",
    "agent",
    "india",
    "claude",
    "codex"
  ],
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "docs",
    "examples",
    "schemas",
    "integrations",
    "AGENTS.md",
    "ANTIGRAVITY.md",
    "CLAUDE.md",
    "CODEX.md",
    "README.md",
    "LICENSE",
    "SECURITY.md"
  ],
  "exports": {
    ".": "./dist/index.js",
    "./platform": "./dist/platform/index.js"
  },
  "bin": {
    "career-strategy": "dist/cli/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "check": "npm run build && npm test && npm run docs:check",
    "dev": "tsx src/cli/index.ts",
    "protocol:describe": "tsx src/cli/index.ts describe",
    "demo": "tsx src/cli/index.ts run examples/score-request.example.json",
    "demo:email": "tsx src/cli/index.ts run examples/email-request.example.json",
    "docs:check": "node scripts/check-doc-links.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
